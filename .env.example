DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins, scheme and port included. While DJANGO_DEBUG=true and this is empty,
# both http://localhost:5173 and http://127.0.0.1:5173 are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave REDIS_URL unset for local development and a single process: websocket groups and
# socket counts then live in memory. Set it only when several ASGI workers must share them:
# REDIS_URL=redis://127.0.0.1:6379/0
PINGO_MOBILE_V2_ENABLED=false
TIME_ZONE=Africa/Johannesburg
VAPID_PRIVATE_KEY=.secrets/vapid_private.pem
VAPID_SUBJECT=mailto:admin@example.com

# Password-reset email. Leave unset to use the console backend (prints the
# email to the runserver log instead of sending it). Example for Resend's
# SMTP relay, which uses implicit SSL on port 465:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=replace-with-your-resend-api-key
# EMAIL_USE_SSL=true
# DEFAULT_FROM_EMAIL=Pingo <no-reply@yourdomain.com>
FRONTEND_BASE_URL=http://localhost:5173
